@*
    
*@
@{
}

<link rel="stylesheet" href="~/css/ProductPageStyleSheet.css" asp-append-version="true" />

@model IEnumerable<Product>
  <h1><u>JCL's Products</u></h1>
<div class="productGrid">
@foreach (var p in Model)
{
<div class="box">
            <div style="display: flex; flex-wrap: wrap; flex-direction: column; justify-content: center">
<h3 class="headerJ-1">@p.name</h3>
                <div style="display: flex; flex-wrap: wrap; flex-direction: column;text-align: center; justify-content: center">
<img src="/JCLImages/@p.imageSrc" alt = "" style="width:300px; height:300px;" />
<br>
@p.description
<h4>@p.price.ToString("c")</h4>
</div>
</div>
<form id="@p.productID" asp-action="AddToCart"
asp-controller="Cart" method="post" class="text-center m-2 p-1">
<input type="hidden" value= "@p.productID" name= "productID"/>
<input type="hidden" name="returnUrl"
value="@ViewContext.HttpContext.Request.PathAndQuery()" />
<button type="submit" class="buttonJ-1 btn btn-info btn-sm ">
Add To Cart
</button>
</form>
</div>
}
</div>