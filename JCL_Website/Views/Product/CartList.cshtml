@{
}
@model CartRepository
<!DOCTYPE html>
    <html>
    <head>
        <meta name="viewport" content="width=device-width" />
        <title>My Cart</title>
    </head>
    <body>
        <div class="text-center">
            <h1 class="display-4">Welcome</h1>
            <p>uhh there is nothing here yet...</p>
        <a asp-controller="Home" asp-action="Index">Return HOME</a>
        </div>
        <div class="text-center">
            <p> The contents of your cart will go here:</p>
            @foreach (var p in Model.Products)
            {
                <div>
                    <h3>@p.name</h3>
                    @p.description
                    <h4>@p.price.ToString("c")</h4>
                    <button asp-controller="Product" asp-action="removeProductFromCart" asp-route-product="@p">Remove From Cart</button>
                </div>
            }
        </div>
        <div>
            <p>Amount due: @Model.getCartSum()</p>
        </div>
    </body>
</html>
