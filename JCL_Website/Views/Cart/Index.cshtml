@using JCL_Website.Models.ViewModels
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model CartIndexViewModel
<!DOCTYPE html>
<html>
    <head>
        <meta name="viewport" content="width=device-width" />
        <title>My Cart</title>
    </head>
    <body class="specialBodyJ">
        <div class="contentDivJ-1">
            <h1 class="headerJ-1">Your Cart</h1>
            <div class="contentDivJ-2">
                <p style="display: none">@Model.Cart.ComputeTotalValue()</p>
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th class="text-center">Quantity</th>
                            <th>Item</th>
                            <th class="text-right">Price</th>
                            <th class="text-right">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Cart.Lines)
                        {
                            <tr>
                                <td class="text-center">@line.Quantity</td>
                                <td class="text-left">@line.Product.name</td>
                                <td class="text-right">@line.Product.price.ToString("c")</td>
                                <td class="text-right">
                                    @((line.Quantity * line.Product.price).ToString("c"))
                                </td>
                                <td>
                                    <form asp-action="RemoveFromCart" method="post">
                                        <input type="hidden" name="ProductID"
                                               value="@line.Product.productID" />
                                        <input type="hidden" name="returnUrl"
                                               value="@Model.ReturnUrl" />
                                        <button type="submit" class="btn btn-sm btn-danger ">
                                            Remove
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-right">Shipping Fee:</td>
                            <td class="text-right">
                                + $5.00
                            </td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-right">Sales Tax:</td>
                            <td class="text-right">
                                + @Model.Cart.GetCurrentTaxAmnt().ToString("c")
                            </td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-right">Total:</td>
                            <td class="text-right">
                                @Model.Cart.ComputeTotalValue().ToString("c")
                            </td>
                        </tr>
                    </tfoot>
                </table>

            </div>
            <div class="text-center">
                <a class="btn btn-primary buttonJ-1" asp-action="Index" asp-controller="Product">Continue shopping</a>
                <a class="btn btn-primary buttonJ-1" asp-action="Checkout" asp-controller="Order">
                    Checkout
                </a>
            </div>
        </div>
    </body>
</html>

