﻿@{
ViewData["Title"] = "FAQ";
}
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="text-center">
    <h1 class="mb-5">Frequently Asked Questions</h1>
</div>

<div class="FAQGrid">
    <div class="faqbox">
        <h5 class>Will shipping charges apply to my order?</h5>
        <p>JCL covers the shipping charges, even for returns.</p>
    </div>

    <div class="faqbox">
        <h5 class>My package is showing signs of damage.</h5>
        <p>We recommend that you return the package without opening, and we will refund your purchase. If the products are damaged, please contact customer support no more than 2 days after delivery.</p>
    </div>

    <div class="faqbox">
        <h5 class>I did not receive what I ordered.</h5>
        <p>If you did not receive the correct items, please contact Customer Support no more than 2 days after delivery and keep all packaging.</p>
    </div>

    <div class="faqbox">
        <h5 class>Can I cancel my order?</h5>
        <p>You can cancel your order within 12 hours of placing it by contacting Customer Support.</p>
    </div>

    <div class="faqbox">
        <h5 class>Does JCL have any relation to JBL?</h5>
        <p>JCL is legally distinct from our competitors, and we strive to distinguish ourselves within the audio market on our own merits.</p>
    </div>

    <div class="faqbox">
        <h5 class>How can I track my order?</h5>
        <p>After checkout you will be given your order ID. Hold on to it, and navigate to the Track My Order page, then input your ID to see your order status.</p>
    </div>

    <div class="faqbox">
        <h5 class>What payment methods are accepted?</h5>
        <p>We accept payments from all major credit cards.</p>
    </div>

    <div class="faqbox">
        <h5 class>Can I register an account with JCL?</h5>
        <p>Unfortunately, account registration is not available at this time.</p>
    </div>
</div>