    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@model Order
<html>
    <body class="specialBodyJ">
        <div class="contentDivJ-1">
            <h1 class="headerJ-1">Check out now</h1>
            <div class="contentDivJ-2">
                <h3>Please enter your details, and we'll ship your goods to you as soon as we can!</h3>

                <div asp-validation-summary="All" class="text-danger"></div>
                <form asp-action="Checkout" method="post">
                <h2 class="headerJ-1">Shipping Information</h2>
                    <div style="text-align: left">
                        <div class="form-group">
                            <label>Name:</label><input asp-for="Name" class="form-control" />
                        </div>
                        <p>Address:</p>
                        <div class="form-group">
                        <label><i>Line 1:</i></label><input asp-for="Line1" class="form-control" />
                        </div>
                        <div class="form-group">
                        <label><i>Line 2:</i></label><input asp-for="Line2" class="form-control" />
                        </div>
                        <div class="form-group">
                        <label><i>Line 3:</i></label><input asp-for="Line3" class="form-control" />
                        </div>
                    </div>
                <div class="contentDivJ-3">
                        <div class="form-group">
                            <label>City:</label><input asp-for="City" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>State:</label><input asp-for="State" class="form-control" />
                        </div>
        
                        <div class="form-group">
                            <label>Zip:</label><input asp-for="Zip" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>Country:</label><input asp-for="Country" class="form-control" />
                        </div>
                </div>
                    <h2 class="headerJ-1">Payment</h2>
                <div class="contentDivJ-3">
                        <div class="form-group">
                            <label>Name On Card:</label><input class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>Card Number:</label><input type="number" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>Expires:</label><input type="month" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>Security Code:</label><input type="number" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>Billing Addres:</label><input class="form-control" />
                        </div>
                </div>
                    <div class="text-center">
                        <input class="btn btn-primary buttonJ-1" type="submit" value="Complete Order" />
                    </div>
                </form>

            </div>
        </div>
    </body>

</html>
